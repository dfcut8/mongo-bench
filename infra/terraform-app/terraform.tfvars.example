# Apply terraform-core-compute and terraform-db before this project.
# The app namespace and its database Secret are created without a service image.
# Enable this only after the Go service has a Dockerfile and supports the
# HTTP_ADDR, MONGODB_URI, and MONGODB_DATABASE environment variables.
#
# application = {
#   image_tag       = "dev-<git-commit-sha>"
#   build_context   = "../.."
#   source_revision = "<git-commit-sha>"
#   port            = 8080
# }
#
# To deploy an image already pushed from this machine, omit build_context.
